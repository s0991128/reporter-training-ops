{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operational Checklist Metadata",
  "type": "object",
  "required": ["version", "source", "reviewStatus", "items"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "source": {
      "type": "object",
      "required": ["file", "rowCount"],
      "properties": { "file": { "const": "업무목록.csv" }, "rowCount": { "type": "integer", "const": 117 } },
      "additionalProperties": false
    },
    "reviewStatus": { "enum": ["PENDING_REVIEW", "REVIEWED"] },
    "items": {
      "type": "object",
      "propertyNames": { "pattern": "^task-[0-9]+$" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "phase": { "enum": ["사전준비", "교육운영", "종료처리", "정산", "결과보고"] },
          "timing": { "type": "object" },
          "reviewStatus": { "enum": ["PENDING_REVIEW", "REVIEWED"] },
          "required": { "type": "boolean" },
          "riskLevel": { "enum": ["HIGH", "MEDIUM", "LOW"] },
          "assigneeRole": { "type": "string" },
          "estimatedMinutes": { "type": "integer", "minimum": 0 },
          "completionCriteria": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "budget": { "type": "object" },
          "documents": { "type": "array" },
          "handover": { "type": "object" },
          "conditional": { "type": "boolean" },
          "pendingFields": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
